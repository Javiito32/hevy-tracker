generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  password_hash  String
  role           String    @default("user") // admin, user
  is_active      Boolean   @default(true)
  hevy_api_key   String?
  height         Float?
  sex            String?
  birth_date     DateTime?
  injuries_notes String?   // free-text field for injuries, limitations, contraindications
  last_login_at  DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  workouts       Workout[]
  mesocycles     Mesocycle[]
  macrocycles    Macrocycle[]
  body_metrics   BodyMetric[]
  conversations  AiConversation[]
  ai_notes       AiNote[]
  foods          Food[]
  diet_plans     DietPlan[]
}

model BodyMetric {
  id                   String   @id @default(uuid())
  user_id              String
  user                 User     @relation(fields: [user_id], references: [id])
  date                 DateTime
  weight               Float?
  body_fat_percentage  Float?
  neck                 Float?
  chest                Float?
  waist                Float?
  hips                 Float?
  left_bicep           Float?
  right_bicep          Float?
  left_bicep_relaxed   Float?
  right_bicep_relaxed  Float?
  left_forearm         Float?
  right_forearm        Float?
  hrv                  Float?
  resting_hr           Int?
  left_thigh           Float?
  right_thigh          Float?
  left_calf            Float?
  right_calf           Float?
  shoulder             Float?
  abdomen              Float?
  lean_mass            Float?
  raw_data             String?
  source               String   @default("hevy")
  created_at           DateTime @default(now())
}

model Macrocycle {
  id          String      @id @default(uuid())
  user_id     String
  user        User        @relation(fields: [user_id], references: [id])
  name        String
  goal        String?
  start_date  DateTime
  end_date    DateTime?
  notes       String?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  mesocycles  Mesocycle[]
}

model Mesocycle {
  id                   String    @id @default(uuid())
  user_id              String
  user                 User      @relation(fields: [user_id], references: [id])
  name                 String
  start_date           DateTime
  end_date             DateTime?
  goal                 String?
  split_description    String?
  target_volume_weekly Int?
  notes                String?
  status               String    @default("active")
  final_summary        String?
  final_summary_model  String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  macrocycle_id        String?
  macrocycle           Macrocycle? @relation(fields: [macrocycle_id], references: [id])

  workouts             Workout[]
  evaluations          MesocycleEvaluation[]
  diary_notes          MesocycleNote[]
}

model Workout {
  id                   String    @id @default(uuid())
  user_id              String
  user                 User      @relation(fields: [user_id], references: [id])
  hevy_id              String
  date                 DateTime
  start_time           DateTime?
  end_time             DateTime?
  duration             Int?
  name                 String
  description          String?
  total_volume         Float?
  total_tonnage        Float?
  rpe_avg              Float?
  exercises_summary    String?
  raw_data             String?
  notes                String?
  ai_analysis          String?
  ai_model             String?

  mesocycle_id         String?
  mesocycle            Mesocycle? @relation(fields: [mesocycle_id], references: [id])

  session_notes        SessionNote[]

  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@unique([user_id, hevy_id])
}

model SessionNote {
  id             String   @id @default(uuid())
  workout_id     String
  workout        Workout  @relation(fields: [workout_id], references: [id])
  content        String
  ai_feedback    String?
  created_at     DateTime @default(now())
}

model MesocycleEvaluation {
  id               String    @id @default(uuid())
  mesocycle_id     String
  mesocycle        Mesocycle @relation(fields: [mesocycle_id], references: [id])
  week_number      Int
  evaluation_date  DateTime
  summary          String?
  volume_trend     String?
  progress_score   Int?
  ai_analysis      String?
  ai_model         String?
  recommendations  String?
  created_at       DateTime  @default(now())
}

model MesocycleNote {
  id           String    @id @default(uuid())
  mesocycle_id String
  mesocycle    Mesocycle @relation(fields: [mesocycle_id], references: [id], onDelete: Cascade)
  date         DateTime
  content      String
  tags         String?
  created_at   DateTime  @default(now())
}

model AiConversation {
  id             String    @id @default(uuid())
  user_id        String
  user           User      @relation(fields: [user_id], references: [id])
  context_type   String    @default("general")
  context_id     String?
  /// Derived from the first user message; null until the first turn completes.
  title          String?
  created_at     DateTime  @default(now())
  /// Last activity. Written explicitly at the end of each chat turn — NOT
  /// @updatedAt, which only fires when this row itself is written and would
  /// go stale as messages are appended.
  updated_at     DateTime  @default(now())

  messages       AiMessage[]

  @@index([user_id, context_type, updated_at])
}

model AiMessage {
  id               String         @id @default(uuid())
  conversation_id  String
  conversation     AiConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  role             String
  content          String
  /// Total tokens billed for the turn (input + output, plus any provider extras).
  /// Kept alongside the split: it is the ONLY usage data on messages written
  /// before the in/out breakdown existed, where the two fields below are null.
  tokens_used      Int?
  /// Prompt tokens. Null for messages predating the breakdown — cost cannot be
  /// computed for those, and the admin panel reports them as such rather than
  /// estimating a split.
  input_tokens     Int?
  /// Completion tokens. Priced several times higher than input, which is why the
  /// split is stored rather than derived from the total.
  output_tokens    Int?
  model_used       String?
  created_at       DateTime       @default(now())

  @@index([conversation_id, created_at])
  /// Date-range filtering in the admin analytics scans by timestamp alone.
  @@index([created_at])
}

/// Per-million-token price of a model, editable from /admin so a vendor price
/// change doesn't need a deploy. Keyed by the slug the provider reports in
/// AiMessage.model_used (e.g. 'anthropic/claude-sonnet-5').
model AiModelPrice {
  id            String   @id @default(uuid())
  model         String   @unique
  /// USD per 1M input tokens. Per-million is the unit vendors publish, which
  /// keeps the admin form free of 8-decimal figures.
  input_per_1m  Float
  /// USD per 1M output tokens.
  output_per_1m Float
  currency      String   @default("USD")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model AiNote {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  content    String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

/// Catalogue entry for the nutrition feature.
///
/// EVERY nutrient field below is expressed PER 100 g of product — the single
/// basis the whole feature computes on, which is why none of them carry a
/// `_100g` suffix. Rows are user-scoped like every other model: the same Open
/// Food Facts product imported by two users yields two rows, the price of not
/// introducing a global catalogue with its own admin surface.
///
/// Foods are hard-deleted. History survives it because DietItem snapshots these
/// values at the moment the food is added to a meal — see DietItem.nutrients_snapshot.
model Food {
  id             String  @id @default(uuid())
  user_id        String
  user           User    @relation(fields: [user_id], references: [id])
  name           String
  brand          String?
  barcode        String?
  /// manual | openfoodfacts
  source         String  @default("manual")
  /// Provider-side id. Equal to `barcode` for Open Food Facts, but kept separate
  /// so a second provider can be added without a migration.
  external_id    String?
  /// Grams in one natural unit (1 huevo = 60). Enables quick-add by units.
  serving_size_g Float?
  /// Label for that unit ("1 unidad", "1 vaso", "1 rebanada").
  serving_label  String?

  /// Required: a food whose energy is unknown makes every total that includes it
  /// silently wrong. The Open Food Facts importer rejects products with no
  /// resolvable energy rather than storing a null here.
  kcal      Float
  protein_g Float @default(0)
  carbs_g   Float @default(0)
  fat_g     Float @default(0)

  /// The 12 tracked micronutrients. Nullable, and null means UNKNOWN — the
  /// calculator propagates it as unknown instead of counting it as zero, so a
  /// total is never quietly understated by a food with missing data.
  fiber_g         Float?
  sugars_g        Float?
  saturated_fat_g Float?
  sodium_mg       Float?
  potassium_mg    Float?
  calcium_mg      Float?
  iron_mg         Float?
  magnesium_mg    Float?
  zinc_mg         Float?
  vitamin_d_ug    Float?
  vitamin_c_mg    Float?
  vitamin_b12_ug  Float?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  diet_items DietItem[]

  /// Makes re-importing the same barcode idempotent. SQLite treats NULLs as
  /// distinct, so any number of manual foods without a barcode coexist fine.
  @@unique([user_id, barcode])
  @@index([user_id, name])
}

/// The diet as a long-lived container. Its actual content lives in DietVersion;
/// this row holds only identity and intent.
model DietPlan {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  name       String
  /// bulk | cut | maintenance | recomp
  goal       String?
  notes      String?
  /// active | archived. At most one 'active' per user, enforced by an updateMany
  /// demotion on create/activate — the same idiom Mesocycle uses.
  status     String   @default("active")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  versions DietVersion[]

  @@index([user_id, status])
}

/// Immutable snapshot of a diet's content. Only a version with status 'draft'
/// may be mutated; publishing freezes it forever. That is what lets the user
/// look back at any past date and see exactly what the plan was, even after the
/// underlying Food rows were edited or deleted.
model DietVersion {
  id             String   @id @default(uuid())
  diet_plan_id   String
  diet_plan      DietPlan @relation(fields: [diet_plan_id], references: [id], onDelete: Cascade)
  version_number Int
  /// draft | active | superseded. At most one 'draft' AND one 'active' per plan.
  status         String   @default("draft")
  /// Half-open range [start_date, end_date): the version in force on date D is
  /// start_date <= D AND (end_date IS NULL OR end_date > D). Publishing on the
  /// same day a version was published would otherwise make two versions match.
  start_date     DateTime?
  end_date       DateTime?
  /// Why this version exists — written by the user when publishing.
  change_note    String?

  /// Daily targets in force for THIS version. On the version rather than the
  /// plan so the history can answer "what was I aiming for back then".
  target_kcal      Float?
  target_protein_g Float?
  target_carbs_g   Float?
  target_fat_g     Float?

  /// Denormalised totals for the reference day, rewritten by
  /// recalcVersionTotals() on every draft mutation. Columns rather than JSON so
  /// the history list and the timeline chart sort and plot without parsing —
  /// the same split as Workout.total_volume vs Workout.exercises_summary.
  total_kcal      Float @default(0)
  total_protein_g Float @default(0)
  total_carbs_g   Float @default(0)
  total_fat_g     Float @default(0)
  /// Full 16-nutrient totals per day type, JSON:
  /// {"all":{...},"training":{...},"rest":{...}}. See nutrition-calculator.ts.
  totals_json     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  meals DietMeal[]

  @@unique([diet_plan_id, version_number])
  @@index([diet_plan_id, status])
}

model DietMeal {
  id              String      @id @default(uuid())
  diet_version_id String
  diet_version    DietVersion @relation(fields: [diet_version_id], references: [id], onDelete: Cascade)
  name            String
  order_index     Int         @default(0)
  /// Free text "08:00". No timezone semantics — it is a label on a plan.
  time_of_day     String?
  /// all | training | rest. 'all' is eaten every day; the other two let the plan
  /// differ between training and rest days without duplicating the whole diet.
  day_type        String      @default("all")
  created_at      DateTime    @default(now())

  items DietItem[]

  @@index([diet_version_id, order_index])
}

model DietItem {
  id           String   @id @default(uuid())
  diet_meal_id String
  diet_meal    DietMeal @relation(fields: [diet_meal_id], references: [id], onDelete: Cascade)
  /// Nulled if the catalogue entry is deleted. The snapshot below keeps the row
  /// fully readable, which is why Food needs no soft-delete flag.
  food_id      String?
  food         Food?    @relation(fields: [food_id], references: [id], onDelete: SetNull)
  /// Denormalised so a past version renders without touching Food at all.
  food_name    String
  quantity_g   Float
  order_index  Int      @default(0)
  /// JSON of the food's per-100 g nutrients AT THE MOMENT the item was added.
  /// This is the mechanism that makes history immutable: correcting a Food's
  /// kcal today never rewrites what the plan said last March.
  nutrients_snapshot String
  created_at   DateTime @default(now())

  @@index([diet_meal_id, order_index])
}
