generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  password_hash  String
  role           String    @default("user") // admin, user
  is_active      Boolean   @default(true)
  hevy_api_key   String?
  height         Float?
  sex            String?
  birth_date     DateTime?
  injuries_notes String?   // free-text field for injuries, limitations, contraindications
  last_login_at  DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  workouts       Workout[]
  mesocycles     Mesocycle[]
  macrocycles    Macrocycle[]
  body_metrics   BodyMetric[]
  conversations  AiConversation[]
  ai_notes       AiNote[]
  foods          Food[]
  diet_plans     DietPlan[]
  alerts         TrainingAlert[]
  personal_records PersonalRecord[]
}

model BodyMetric {
  id                   String   @id @default(uuid())
  user_id              String
  user                 User     @relation(fields: [user_id], references: [id])
  date                 DateTime
  weight               Float?
  body_fat_percentage  Float?
  neck                 Float?
  chest                Float?
  waist                Float?
  hips                 Float?
  left_bicep           Float?
  right_bicep          Float?
  left_bicep_relaxed   Float?
  right_bicep_relaxed  Float?
  left_forearm         Float?
  right_forearm        Float?
  hrv                  Float?
  resting_hr           Int?
  left_thigh           Float?
  right_thigh          Float?
  left_calf            Float?
  right_calf           Float?
  shoulder             Float?
  abdomen              Float?
  lean_mass            Float?
  raw_data             String?
  source               String   @default("hevy")
  created_at           DateTime @default(now())
}

model Macrocycle {
  id          String      @id @default(uuid())
  user_id     String
  user        User        @relation(fields: [user_id], references: [id])
  name        String
  goal        String?
  start_date  DateTime
  end_date    DateTime?
  notes       String?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  mesocycles  Mesocycle[]
}

model Mesocycle {
  id                   String    @id @default(uuid())
  user_id              String
  user                 User      @relation(fields: [user_id], references: [id])
  name                 String
  start_date           DateTime
  end_date             DateTime?
  goal                 String?
  split_description    String?
  target_sessions_weekly Int?
  notes                String?
  status               String    @default("active")
  final_summary        String?
  final_summary_model  String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  macrocycle_id        String?
  macrocycle           Macrocycle? @relation(fields: [macrocycle_id], references: [id])

  /// Hevy routine folder this block was pushed to, if it ever was.
  hevy_folder_id       Int?

  workouts             Workout[]
  evaluations          MesocycleEvaluation[]
  diary_notes          MesocycleNote[]
  planned_weeks        MesocycleWeek[]
  planned_sessions     PlannedSession[]
}

/// Per-week intent within a block: this is where a deload stops being a note in
/// free text and becomes something the app can act on.
model MesocycleWeek {
  id                String    @id @default(uuid())
  mesocycle_id      String
  mesocycle         Mesocycle @relation(fields: [mesocycle_id], references: [id], onDelete: Cascade)
  week_number       Int
  is_deload         Boolean   @default(false)
  /// Reps in reserve prescribed for this week. Drives the suggested loads.
  target_rir        Float?
  /// Multiplier applied to the block's baseline set count (0.5 on a deload).
  volume_multiplier Float     @default(1)
  notes             String?

  @@unique([mesocycle_id, week_number])
}

/// One planned training day. `hevy_routine_id` is what makes the push to Hevy
/// idempotent: present means update that routine, absent means create one.
model PlannedSession {
  id              String    @id @default(uuid())
  mesocycle_id    String
  mesocycle       Mesocycle @relation(fields: [mesocycle_id], references: [id], onDelete: Cascade)
  name            String
  order_index     Int       @default(0)
  /// 1 = Monday … 7 = Sunday. Null for a rotation not tied to weekdays.
  day_of_week     Int?
  notes           String?
  hevy_routine_id String?
  pushed_at       DateTime?

  exercises PlannedExercise[]

  @@index([mesocycle_id, order_index])
}

/// The prescription. What separates this from `split_description` is that every
/// field here is comparable against what the athlete actually logged.
model PlannedExercise {
  id                   String   @id @default(uuid())
  planned_session_id   String
  planned_session      PlannedSession @relation(fields: [planned_session_id], references: [id], onDelete: Cascade)
  /// Null when the AI proposed an exercise with no catalogue match; the name
  /// still prescribes it, it just can't be pushed to Hevy until resolved.
  exercise_template_id String?
  name                 String
  order_index          Int      @default(0)
  target_sets          Int      @default(3)
  rep_min              Int?
  rep_max              Int?
  target_rir           Float?
  rest_seconds         Int?
  /// linear | double_progression | rpe_based — how load advances week to week.
  progression_scheme   String   @default("double_progression")
  notes                String?

  @@index([planned_session_id, order_index])
}

model Workout {
  id                   String    @id @default(uuid())
  user_id              String
  user                 User      @relation(fields: [user_id], references: [id])
  hevy_id              String
  date                 DateTime
  start_time           DateTime?
  end_time             DateTime?
  duration             Int?
  name                 String
  description          String?
  /// Working-set tonnage: warm-up sets are excluded. This is the figure the
  /// whole app means by "volume".
  total_volume         Float?
  /// Every set including warm-ups. Kept distinct from total_volume rather than
  /// duplicating it, which is what it used to do.
  total_tonnage        Float?
  rpe_avg              Float?
  exercises_summary    String?
  raw_data             String?
  notes                String?
  ai_analysis          String?
  ai_model             String?

  mesocycle_id         String?
  /// SetNull, stated explicitly: deleting a block must never delete the
  /// sessions logged during it. The workout is the record of what happened;
  /// the block was only the plan it was attributed to.
  mesocycle            Mesocycle? @relation(fields: [mesocycle_id], references: [id], onDelete: SetNull)

  session_notes        SessionNote[]
  exercises            WorkoutExercise[]
  personal_records     PersonalRecord[]

  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@unique([user_id, hevy_id])
  /// Every range query in the app filters by user and date; without this each
  /// one is a full scan of the user's history.
  @@index([user_id, date])
}

/// Hevy's exercise catalogue — the only source of muscle-group information.
///
/// Non-custom templates are global: "Bench Press (Barbell)" is the same row for
/// every user, which is why user_id is nullable and only set on custom ones.
model ExerciseTemplate {
  id                      String   @id
  title                   String
  /// weight_reps | reps_only | duration | distance | weight_distance ...
  type                    String
  primary_muscle_group    String
  /// JSON array of muscle group slugs.
  secondary_muscle_groups String   @default("[]")
  equipment_category      String?
  is_custom               Boolean  @default(false)
  /// Null for the global catalogue; set only on a user's custom exercises.
  user_id                 String?
  synced_at               DateTime @default(now())

  workout_exercises WorkoutExercise[]

  @@index([user_id])
  @@index([primary_muscle_group])
  @@index([title])
}

/// Manual muscle-group assignment for exercises the catalogue can't resolve —
/// a custom exercise deleted in Hevy, or a workout logged before the template
/// existed. Matched by exercise name because that is all such rows have left.
model ExerciseMuscleOverride {
  id                      String   @id @default(uuid())
  user_id                 String
  exercise_name           String
  primary_muscle_group    String
  secondary_muscle_groups String   @default("[]")
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  @@unique([user_id, exercise_name])
}

/// One exercise within one workout, normalised out of `exercises_summary`.
///
/// `exercises_summary` survives as the immutable display snapshot — the same
/// split as DietItem.nutrients_snapshot — but every aggregate query reads these
/// rows instead of parsing JSON for the whole history.
model WorkoutExercise {
  id                   String   @id @default(uuid())
  workout_id           String
  workout              Workout  @relation(fields: [workout_id], references: [id], onDelete: Cascade)
  /// Denormalised so muscle-group aggregates never join through Workout.
  user_id              String
  /// Denormalised for the same reason: every analysis buckets by date.
  date                 DateTime

  exercise_template_id String?
  template             ExerciseTemplate? @relation(fields: [exercise_template_id], references: [id], onDelete: SetNull)
  /// Snapshot of the title as logged, so the row stays readable if the
  /// template is deleted.
  name                 String
  order_index          Int      @default(0)
  superset_id          Int?

  /// Excludes warm-ups. Volume analysis counts these, never `total_sets`.
  working_sets         Int      @default(0)
  total_sets           Int      @default(0)
  total_volume         Float    @default(0)
  best_e1rm            Float?
  top_set_weight       Float?
  top_set_reps         Int?
  avg_rpe              Float?

  sets ExerciseSet[]

  @@index([user_id, exercise_template_id, date])
  @@index([user_id, name, date])
  @@index([workout_id, order_index])
}

model ExerciseSet {
  id                  String  @id @default(uuid())
  workout_exercise_id String
  workout_exercise    WorkoutExercise @relation(fields: [workout_exercise_id], references: [id], onDelete: Cascade)
  order_index         Int     @default(0)
  /// normal | warmup | dropset | failure. Only 'warmup' is excluded from work.
  set_type            String  @default("normal")
  weight_kg           Float?
  reps                Int?
  rpe                 Float?
  distance_meters     Float?
  duration_seconds    Int?
  /// RPE-corrected when the set carried an RPE, Epley otherwise, null above 12
  /// reps. Stored so progression queries don't recompute it per row.
  e1rm                Float?

  @@index([workout_exercise_id, order_index])
}

/// A detected training problem. One live row per (user, type, subject): a
/// plateau that persists across syncs updates its row rather than accumulating
/// duplicates the athlete has to dismiss one by one.
model TrainingAlert {
  id           String    @id @default(uuid())
  user_id      String
  user         User      @relation(fields: [user_id], references: [id])
  /// plateau | fatigue | undertrained | deload_due | overreaching
  type         String
  /// exercise | muscle_group | global — what `subject` names.
  subject_kind String
  /// Exercise name or muscle group slug; empty string for global alerts.
  subject      String
  severity     String    @default("info") // info | warning | critical
  title        String
  detail       String
  /// JSON with the numbers behind the call, so the UI and the AI can show the
  /// evidence rather than asking the athlete to trust a label.
  payload_json String?
  status       String    @default("active") // active | resolved | dismissed
  detected_at  DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  resolved_at  DateTime?
  dismissed_at DateTime?

  @@unique([user_id, type, subject])
  @@index([user_id, status, detected_at])
}

/// A personal record, stored rather than derived: recomputing "best ever" on
/// every page load means rescanning the whole history, and the athlete wants to
/// know *when* it happened and what it beat.
model PersonalRecord {
  id                   String   @id @default(uuid())
  user_id              String
  user                 User     @relation(fields: [user_id], references: [id])
  exercise_template_id String?
  exercise_name        String
  /// max_weight | e1rm | volume | reps_at_weight
  type                 String
  value                Float
  /// The record this one beat. Null on a first-ever record, which is what lets
  /// the UI say "+2,5 kg" instead of just showing a number.
  previous_value       Float?
  /// Only set for reps_at_weight: the load the rep record was set at.
  at_weight            Float?
  workout_id           String?
  workout              Workout? @relation(fields: [workout_id], references: [id], onDelete: SetNull)
  achieved_at          DateTime

  @@index([user_id, exercise_name, type, achieved_at])
  @@index([user_id, achieved_at])
}

/// Long-running background work: the Hevy sync and the five admin migrations.
///
/// A sync of two years of history is ~50 API calls and hundreds of upserts;
/// that cannot live inside an HTTP request, so it runs detached and the UI
/// polls this row.
model MaintenanceJob {
  id               String    @id @default(uuid())
  /// sync | exercise_templates | rebuild_exercises | recalc_metrics | recalc_records
  kind             String
  /// Null when the job spans every user (the global template catalogue).
  user_id          String?
  status           String    @default("pending") // pending | running | done | error
  progress_current Int       @default(0)
  progress_total   Int       @default(0)
  /// Human-readable current step, shown live in the admin panel.
  message          String?
  /// JSON summary of what the job did, kept after completion for the log.
  result_json      String?
  error            String?
  created_at       DateTime  @default(now())
  started_at       DateTime?
  finished_at      DateTime?

  @@index([kind, created_at])
  @@index([status])
}

model SessionNote {
  id             String   @id @default(uuid())
  workout_id     String
  workout        Workout  @relation(fields: [workout_id], references: [id])
  content        String
  ai_feedback    String?
  created_at     DateTime @default(now())
}

model MesocycleEvaluation {
  id               String    @id @default(uuid())
  mesocycle_id     String
  /// Cascades like MesocycleNote: an evaluation is a reading of one block and
  /// means nothing once the block is gone. Without this the relation defaults
  /// to Restrict, which makes any evaluated mesocycle undeletable.
  mesocycle        Mesocycle @relation(fields: [mesocycle_id], references: [id], onDelete: Cascade)
  week_number      Int
  evaluation_date  DateTime
  summary          String?
  volume_trend     String?
  progress_score   Int?
  ai_analysis      String?
  ai_model         String?
  recommendations  String?
  created_at       DateTime  @default(now())
}

model MesocycleNote {
  id           String    @id @default(uuid())
  mesocycle_id String
  mesocycle    Mesocycle @relation(fields: [mesocycle_id], references: [id], onDelete: Cascade)
  date         DateTime
  content      String
  tags         String?
  created_at   DateTime  @default(now())
}

model AiConversation {
  id             String    @id @default(uuid())
  user_id        String
  user           User      @relation(fields: [user_id], references: [id])
  context_type   String    @default("general")
  context_id     String?
  /// Derived from the first user message; null until the first turn completes.
  title          String?
  created_at     DateTime  @default(now())
  /// Last activity. Written explicitly at the end of each chat turn — NOT
  /// @updatedAt, which only fires when this row itself is written and would
  /// go stale as messages are appended.
  updated_at     DateTime  @default(now())

  messages       AiMessage[]

  @@index([user_id, context_type, updated_at])
}

model AiMessage {
  id               String         @id @default(uuid())
  conversation_id  String
  conversation     AiConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  role             String
  content          String
  /// Total tokens billed for the turn (input + output, plus any provider extras).
  /// Kept alongside the split: it is the ONLY usage data on messages written
  /// before the in/out breakdown existed, where the two fields below are null.
  tokens_used      Int?
  /// Prompt tokens. Null for messages predating the breakdown — cost cannot be
  /// computed for those, and the admin panel reports them as such rather than
  /// estimating a split.
  input_tokens     Int?
  /// Completion tokens. Priced several times higher than input, which is why the
  /// split is stored rather than derived from the total.
  output_tokens    Int?
  model_used       String?
  created_at       DateTime       @default(now())

  @@index([conversation_id, created_at])
  /// Date-range filtering in the admin analytics scans by timestamp alone.
  @@index([created_at])
}

/// Per-million-token price of a model, editable from /admin so a vendor price
/// change doesn't need a deploy. Keyed by the slug the provider reports in
/// AiMessage.model_used (e.g. 'anthropic/claude-sonnet-5').
model AiModelPrice {
  id            String   @id @default(uuid())
  model         String   @unique
  /// USD per 1M input tokens. Per-million is the unit vendors publish, which
  /// keeps the admin form free of 8-decimal figures.
  input_per_1m  Float
  /// USD per 1M output tokens.
  output_per_1m Float
  currency      String   @default("USD")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model AiNote {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  content    String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

/// Catalogue entry for the nutrition feature.
///
/// EVERY nutrient field below is expressed PER 100 g of product — the single
/// basis the whole feature computes on, which is why none of them carry a
/// `_100g` suffix. Rows are user-scoped like every other model: the same Open
/// Food Facts product imported by two users yields two rows, the price of not
/// introducing a global catalogue with its own admin surface.
///
/// Foods are hard-deleted. History survives it because DietItem snapshots these
/// values at the moment the food is added to a meal — see DietItem.nutrients_snapshot.
model Food {
  id             String  @id @default(uuid())
  user_id        String
  user           User    @relation(fields: [user_id], references: [id])
  name           String
  brand          String?
  barcode        String?
  /// manual | openfoodfacts
  source         String  @default("manual")
  /// Provider-side id. Equal to `barcode` for Open Food Facts, but kept separate
  /// so a second provider can be added without a migration.
  external_id    String?
  /// Grams in one natural unit (1 huevo = 60). Enables quick-add by units.
  serving_size_g Float?
  /// Label for that unit ("1 unidad", "1 vaso", "1 rebanada").
  serving_label  String?

  /// Required: a food whose energy is unknown makes every total that includes it
  /// silently wrong. The Open Food Facts importer rejects products with no
  /// resolvable energy rather than storing a null here.
  kcal      Float
  protein_g Float @default(0)
  carbs_g   Float @default(0)
  fat_g     Float @default(0)

  /// The 12 tracked micronutrients. Nullable, and null means UNKNOWN — the
  /// calculator propagates it as unknown instead of counting it as zero, so a
  /// total is never quietly understated by a food with missing data.
  fiber_g         Float?
  sugars_g        Float?
  saturated_fat_g Float?
  sodium_mg       Float?
  potassium_mg    Float?
  calcium_mg      Float?
  iron_mg         Float?
  magnesium_mg    Float?
  zinc_mg         Float?
  vitamin_d_ug    Float?
  vitamin_c_mg    Float?
  vitamin_b12_ug  Float?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  diet_items DietItem[]

  /// Makes re-importing the same barcode idempotent. SQLite treats NULLs as
  /// distinct, so any number of manual foods without a barcode coexist fine.
  @@unique([user_id, barcode])
  @@index([user_id, name])
}

/// The diet as a long-lived container. Its actual content lives in DietVersion;
/// this row holds only identity and intent.
model DietPlan {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  name       String
  /// bulk | cut | maintenance | recomp
  goal       String?
  notes      String?
  /// active | archived. At most one 'active' per user, enforced by an updateMany
  /// demotion on create/activate — the same idiom Mesocycle uses.
  status     String   @default("active")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  versions DietVersion[]

  @@index([user_id, status])
}

/// Immutable snapshot of a diet's content. Only a version with status 'draft'
/// may be mutated; publishing freezes it forever. That is what lets the user
/// look back at any past date and see exactly what the plan was, even after the
/// underlying Food rows were edited or deleted.
model DietVersion {
  id             String   @id @default(uuid())
  diet_plan_id   String
  diet_plan      DietPlan @relation(fields: [diet_plan_id], references: [id], onDelete: Cascade)
  version_number Int
  /// draft | active | superseded. At most one 'draft' AND one 'active' per plan.
  status         String   @default("draft")
  /// Half-open range [start_date, end_date): the version in force on date D is
  /// start_date <= D AND (end_date IS NULL OR end_date > D). Publishing on the
  /// same day a version was published would otherwise make two versions match.
  start_date     DateTime?
  end_date       DateTime?
  /// Why this version exists — written by the user when publishing.
  change_note    String?

  /// Daily targets in force for THIS version. On the version rather than the
  /// plan so the history can answer "what was I aiming for back then".
  target_kcal      Float?
  target_protein_g Float?
  target_carbs_g   Float?
  target_fat_g     Float?

  /// Denormalised MEAN DAILY totals, rewritten by recalcVersionTotals() on every
  /// draft mutation. Columns rather than JSON so the history list and the
  /// timeline chart sort and plot without parsing — the same split as
  /// Workout.total_volume vs Workout.exercises_summary.
  ///
  /// These are averages over the weekdays that actually have food (see
  /// `planned_days`), NOT weekly sums: a Mon–Fri plan divided by 7 would report
  /// 71 % of the real intake and manufacture a deficit that isn't there. An
  /// average is also the only figure comparable with target_kcal, which is daily.
  total_kcal      Float @default(0)
  total_protein_g Float @default(0)
  total_carbs_g   Float @default(0)
  total_fat_g     Float @default(0)
  /// How many weekdays backed the averages above. Kept as a column because
  /// plans/[id]/versions.get.ts reads hot columns only, by design — without it
  /// the history would show a mean with no idea what it is a mean of.
  planned_days    Int   @default(0)
  /// Full 16-nutrient totals per weekday, JSON:
  /// {"days":{"1":{...},…,"7":{...}},"average":{...},"average_coverage":{...},
  ///  "planned_days":[1,2,3]}. See nutrition-calculator.ts.
  totals_json     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  meals       DietMeal[]
  day_targets DietDayTarget[]

  @@unique([diet_plan_id, version_number])
  @@index([diet_plan_id, status])
}

model DietMeal {
  id              String      @id @default(uuid())
  diet_version_id String
  diet_version    DietVersion @relation(fields: [diet_version_id], references: [id], onDelete: Cascade)
  name            String
  /// 1 = Monday … 7 = Sunday, the same convention as PlannedSession.day_of_week.
  ///
  /// Every weekday holds its OWN independent meal list: a meal eaten all week is
  /// seven rows, not one row with a flag. That redundancy is the feature — it is
  /// what lets Tuesday be edited without touching Monday. It replaced a
  /// `day_type` of all|training|rest that no part of the UI could ever set.
  ///
  /// No @default on purpose: Prisma then refuses any create that omits it, so a
  /// forgotten weekday is a compile error rather than a meal silently piling up
  /// on Monday — the likeliest bug in this design.
  weekday         Int
  /// Position within its own weekday, not within the version.
  order_index     Int         @default(0)
  /// Free text "08:00". No timezone semantics — it is a label on a plan.
  time_of_day     String?
  created_at      DateTime    @default(now())

  items DietItem[]

  @@index([diet_version_id, weekday, order_index])
}

/// A per-weekday OVERRIDE of the version's daily targets, for plans that vary
/// the intake across the week (carb cycling, a bigger training day).
///
/// It is an override rather than a required row per day: a diet with the same
/// target all week stores nothing here, and every existing reader keeps working
/// off DietVersion.target_* unchanged. Resolution lives in `effectiveTarget`.
model DietDayTarget {
  id              String      @id @default(uuid())
  diet_version_id String
  diet_version    DietVersion @relation(fields: [diet_version_id], references: [id], onDelete: Cascade)
  /// 1 = Monday … 7 = Sunday.
  weekday         Int
  /// null = this macro inherits the version's target. A row whose four values are
  /// all null is deleted, so "no override" and "empty override" are one state.
  target_kcal      Float?
  target_protein_g Float?
  target_carbs_g   Float?
  target_fat_g     Float?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([diet_version_id, weekday])
}

model DietItem {
  id           String   @id @default(uuid())
  diet_meal_id String
  diet_meal    DietMeal @relation(fields: [diet_meal_id], references: [id], onDelete: Cascade)
  /// Nulled if the catalogue entry is deleted. The snapshot below keeps the row
  /// fully readable, which is why Food needs no soft-delete flag.
  food_id      String?
  food         Food?    @relation(fields: [food_id], references: [id], onDelete: SetNull)
  /// Denormalised so a past version renders without touching Food at all.
  food_name    String
  quantity_g   Float
  order_index  Int      @default(0)
  /// JSON of the food's per-100 g nutrients AT THE MOMENT the item was added.
  /// This is the mechanism that makes history immutable: correcting a Food's
  /// kcal today never rewrites what the plan said last March.
  nutrients_snapshot String
  created_at   DateTime @default(now())

  @@index([diet_meal_id, order_index])
}
