DATABASE_URL="file:./prisma/dev.db"

# Hevy API key: NO va aquí. Es por usuario, se configura desde la página de Ajustes
# de la app y se guarda en la tabla User (hevy_api_key).

# OpenRouter API key — proveedor de IA por defecto (AI_PROVIDER=openrouter en server/utils/ai-config.ts)
# (dev: leída en build time; prod Docker: Nuxt usa NUXT_OPENROUTER_API_KEY en runtime)
OPENROUTER_API_KEY=sk-or-...
NUXT_OPENROUTER_API_KEY=sk-or-...

# OpenAI API key — solo necesaria si AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
NUXT_OPENAI_API_KEY=sk-...

# Nutriinfo API key — fallback de código de barras cuando Open Food Facts no tiene el producto
# (dev: leída en build time; prod Docker: Nuxt usa NUXT_NUTRIINFO_API_KEY en runtime)
# Solicitar en https://www.nutriinfo.es/desarrolladores
NUTRIINFO_API_KEY=nk_live_...
NUXT_NUTRIINFO_API_KEY=nk_live_...

NUXT_SESSION_PASSWORD=cambia-esto-por-una-cadena-aleatoria-de-minimo-32-caracteres
